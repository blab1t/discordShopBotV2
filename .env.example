# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# The new server this bot may operate in. Enable Discord Developer Mode to copy this ID.
GUILD_ID=

# The minimum staff role allowed to manage proxies and take over TicketsBot tickets.
# Users with this role or a role above it can run /proxy and /ticket takeover.
STAFF_ROLE_ID=

# Your Discord user ID. Optional; receives pings for new proxy requests and bypasses the staff-role check.
OWNER_ID=

# Optional: blabit.dev API key (auto-fills Hypixel-format stats in the proxy wizard)
BLABIT_API_KEY=

# Optional: free CoinGecko demo key for higher crypto rate limits
COINGECKO_API_KEY=
